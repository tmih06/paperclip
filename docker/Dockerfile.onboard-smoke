FROM ubuntu:24.04
COPY --from=oven/bun:1.4.4-debian@sha256:93d5032fe06d163427822dc1598f420363759bb18155c9cc90eb1be05a64a19e /usr/local/bin/bun /usr/local/bin/bun

ARG PAPERCLIPAI_VERSION=latest
ARG HOST_UID=10001

ENV DEBIAN_FRONTEND=noninteractive \
  PAPERCLIP_HOME=/paperclip \
  PAPERCLIP_OPEN_ON_LISTEN=false \
  HOST=0.0.0.0 \
  PORT=3100 \
  HOME=/home/paperclip \
  LANG=en_US.UTF-8 \
  LC_ALL=en_US.UTF-8 \
  NPM_CONFIG_UPDATE_NOTIFIER=false \
  PAPERCLIPAI_VERSION=${PAPERCLIPAI_VERSION}

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl locales \
  && locale-gen en_US.UTF-8 \
  && groupadd --gid 10001 paperclip \
  && useradd --create-home --shell /bin/bash --uid "${HOST_UID}" --gid 10001 paperclip \
  && mkdir -p /paperclip /home/paperclip/workspace \
  && chown -R paperclip:paperclip /paperclip /home/paperclip \
  && rm -rf /var/lib/apt/lists/*

VOLUME ["/paperclip"]
WORKDIR /home/paperclip/workspace
EXPOSE 3100
USER paperclip

# --bind lan is required: `onboard --yes` without an explicit --bind prefers
# trusted-local defaults, which write a loopback bind into the instance config
# and ignore the deployment env vars. A loopback listener inside the container
# is unreachable through Docker's port mapping, so the smoke health check can
# never pass without this flag.
CMD ["bash", "-lc", "set -euo pipefail; mkdir -p \"$PAPERCLIP_HOME\"; bun x --bun --registry=https://registry.npmjs.org \"paperclipai@${PAPERCLIPAI_VERSION}\" onboard --yes --bind lan --data-dir \"$PAPERCLIP_HOME\""]
