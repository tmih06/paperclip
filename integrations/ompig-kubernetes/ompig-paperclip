#!/bin/sh
set -eu

if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then
  exec ompig-slim --version
fi

state="${OMPIG_STATE_DIR:-/workspace/.ompig-state}"
mkdir -p "$state"
model_provider="${OMPIG_PROVIDER:-deploy}"
model_id="${OMPIG_MODEL_ID:-deepseek-ai/deepseek-v4.1-flash-1017}"
prompt=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --provider) model_provider="${2:-$model_provider}"; shift 2 ;;
    --model) model_id="${2:-$model_id}"; shift 2 ;;
    --session|--skill|--extension|--append-system-prompt|--tools|--thinking) shift 2 ;;
    -p|--prompt) prompt="${2:-}"; shift 2 ;;
    --mode) shift 2 ;;
    --) shift; prompt="${1:-}"; shift ;;
    *) prompt="$1"; shift ;;
  esac
done

if [ -z "$prompt" ]; then
  echo '{"type":"error","message":"ompig-paperclip received no prompt"}'
  exit 2
fi

request_id="${PAPERCLIP_RUN_ID:-ompig-run}"
result="$(ompig-slim durable run \
  --state "$state" \
  --cwd "${PWD:-/workspace}" \
  --model "$model_provider/$model_id" \
  --request-id "$request_id" \
  "$prompt")"

node - "$result" <<'NODE'
const raw = process.argv[2];
const result = JSON.parse(raw);
if (result.status !== "done") {
  process.stdout.write(JSON.stringify({ type: "error", message: result.reason || "ompig durable run failed" }) + "\n");
  process.exitCode = 1;
} else {
  const usage = Array.isArray(result.usage) ? result.usage.at(-1) : null;
  process.stdout.write(JSON.stringify({
    type: "agent_end",
    messages: [{
      role: "assistant",
      content: result.answer || "",
      stopReason: "stop",
      ...(usage ? { usage: {
        input: usage.input_tokens || 0,
        output: usage.output_tokens || 0,
        cacheRead: usage.cache_read_tokens || 0,
        cacheWrite: usage.cache_write_tokens || 0,
      } } : {}),
    }],
  }) + "\n");
}
NODE
