[Unit]
Description=Paperclip factory sandbox bridge and scoped firewall
After=docker.service
Requires=docker.service
Before=paperclip-factory.service

[Service]
Type=oneshot
RemainAfterExit=true
# Same qualified Node and checkout installation paths as paperclip-factory.service.
ExecStart=/opt/node24/bin/node /opt/paperclip/integrations/ompig-factory/scripts/configure-network.mjs

[Install]
WantedBy=multi-user.target
