# Build from a pinned ompig workspace image; the resulting image is the reusable agent.
ARG OMPIG_IMAGE
ARG NODE_IMAGE=node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5
FROM ${OMPIG_IMAGE} AS ompig
FROM ${NODE_IMAGE}
USER root
RUN apk add --no-cache bash ca-certificates curl git jq openssh-client patch python3 ripgrep tar unzip \
    && mkdir -p /workspace /home/agent /opt/agent \
    && chown 1000:1000 /workspace /home/agent
COPY --from=ompig /usr/local/bin/ompig-slim /usr/local/bin/ompig-slim
COPY integrations/ompig-factory/examples/developer.md /opt/agent/instructions.md
ENV HOME=/home/agent
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["ompig-slim"]
