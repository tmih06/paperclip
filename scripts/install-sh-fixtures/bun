#!/usr/bin/env bash
set -euo pipefail

# Test double for the Bun CLI used by scripts/install.sh. It records the exact
# invocation and the registry/config environment the installer produced, then
# exits successfully. Installer tests must never reach a real registry.
: "${PAPERCLIP_INSTALL_TEST_LOG:?PAPERCLIP_INSTALL_TEST_LOG is required}"

case "${1:-}" in
  --version)
    printf '%s\n' "${PAPERCLIP_INSTALL_TEST_BUN_VERSION:-1.4.4}"
    exit 0
    ;;
esac

{
  printf 'X=%s\n' "$*"
  printf 'BUN_CONFIG_REGISTRY=%s\n' "${BUN_CONFIG_REGISTRY:-}"
  printf 'NPM_CONFIG_REGISTRY=%s\n' "${NPM_CONFIG_REGISTRY:-}"
  printf 'npm_config_registry=%s\n' "${npm_config_registry:-}"
  printf 'NPM_CONFIG_USERCONFIG=%s\n' "${NPM_CONFIG_USERCONFIG:-}"
  printf 'npm_config_userconfig=%s\n' "${npm_config_userconfig:-}"
  printf 'XDG_CONFIG_HOME=%s\n' "${XDG_CONFIG_HOME:-}"
  if [ -n "${NPM_CONFIG_USERCONFIG:-}" ] && [ -f "$NPM_CONFIG_USERCONFIG" ]; then
    sed 's/^/npmrc:/' "$NPM_CONFIG_USERCONFIG"
  fi
} >>"$PAPERCLIP_INSTALL_TEST_LOG"
